{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mkca-insurance-api.onrender.com/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/insurance",
      "destination": "/products",
      "statusCode": 308
    },
    {
      "source": "/insurance/products",
      "destination": "/products",
      "statusCode": 308
    },
    {
      "source": "/insurance/quote",
      "destination": "/quote-calculator",
      "statusCode": 308
    },
    {
      "source": "/insurance/apply",
      "destination": "/quote-calculator",
      "statusCode": 308
    },
    {
      "source": "/insurance/payment",
      "destination": "/payment",
      "statusCode": 308
    },
    {
      "source": "/insurance/claims",
      "destination": "/claims",
      "statusCode": 308
    },
    {
      "source": "/payment/callback",
      "destination": "/payment-callback",
      "statusCode": 308
    }
  ]
}
